{
  "name": "tritonlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Instructor ratings and historical course context inside UC San Diego TSS.",
  "scripts": {
    "build": "node build.mjs",
    "build:development-data": "node build.mjs --development-data",
    "watch": "node build.mjs --watch",
    "import:easy-a": "node scripts/import-easy-a.mjs",
    "audit:instructors": "node scripts/audit-instructor-matches.mjs",
    "recommend:names": "node scripts/recommend-name-matches.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
