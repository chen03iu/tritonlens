{
  "manifest_version": 3,
  "name": "TritonLens",
  "version": "0.1.0",
  "description": "Instructor ratings and historical course context inside UC San Diego TSS.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://tss.ucsd.edu/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
